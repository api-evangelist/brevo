{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brevo Contacts Agent Status Senders API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Senders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get email senders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brevo.com/v3/senders",
            "params": [
              {
                "name": "ip",
                "value": "",
                "type": "query",
                "description": "Filter senders by dedicated IP address."
              },
              {
                "name": "domain",
                "value": "",
                "type": "query",
                "description": "Filter senders by domain name."
              }
            ]
          },
          "docs": "Retrieves the list of all sender identities configured in the account for use with transactional and marketing emails."
        },
        {
          "info": {
            "name": "Create a new sender",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.brevo.com/v3/senders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new sender identity that can be used for sending transactional and marketing emails. The sender must be verified before use."
        }
      ]
    }
  ],
  "bundled": true
}