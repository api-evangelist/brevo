        {
          "id": "73ad247f-750c-4130-8130-0161cdb51ecf",
          "name": "Get the list of object records and total records count for an object.",
          "request": {
            "name": "Get the list of object records and total records count for an object.",
            "description": {
              "content": "<Note title=\"Enterprise access only\">Custom objects are only available to Enterprise plans.\nThis feature is in beta. These are subject to change.</Note>\nThis API retrieves a list of object records along with their associated records and provides the total count of records for the specified object. **Note**: Contact as object type is not supported in this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "objects",
                ":object_type",
                "records"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<long>",
                  "description": "(Required) Number of records returned per page"
                },
                {
                  "disabled": false,
                  "key": "page_num",
                  "value": "<long>",
                  "description": "(Required) Page number for pagination. It's used to fetch the object records on a provided page number. Must be a valid positive integer."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "desc",
                  "description": "Sort order, must be 'asc' or 'desc'. Default to 'desc' if not provided."
                },
                {
                  "disabled": false,
                  "key": "association",
                  "value": "<string>",
                  "description": "Whether to include associations, must be 'true' or 'false'. Default to 'false' if not provided."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "object_type",
                  "description": "(Required) Object type for the records to retrieve. Must be a previously created custom object type. Contact as object type is not supported in this endpoint."
                }
